<Page
    x:Class="Project.Views.Auth.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Black">

    <Grid>

        <!-- Background Image -->
        <Image Source="ms-appx:///Assets/HomePage/home-bg.png"
       Stretch="UniformToFill"/>

        <!-- Dark Overlay -->
        <Rectangle>
            <Rectangle.Fill>
                <SolidColorBrush Color="Black"
                                 Opacity="0.38"/>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Main Content -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="420"
                    Spacing="18">

            <!-- Logo -->
            <Border Width="100"
                    Height="100"
                    CornerRadius="28"
                    Background="#2563EB"
                    HorizontalAlignment="Center">

                <TextBlock Text="D"
                           FontSize="46"
                           FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- App Name -->
            <TextBlock Text="DriveEase"
                       FontSize="54"
                       FontWeight="SemiBold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>

            <!-- Accent Line -->
            <Border Width="70"
                    Height="4"
                    CornerRadius="10"
                    Background="#3B82F6"
                    HorizontalAlignment="Center"
                    Margin="0,2,0,4"/>

            <!-- Slogan -->
            <TextBlock Text="Rent cars easily, quickly and safely."
                       FontSize="18"
                       Foreground="#E5E7EB"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,0,0,20"/>

            <!-- Sign In Button -->
            <Button Content="Sign In"
                    Height="64"
                    FontSize="21"
                    FontWeight="SemiBold"
                    CornerRadius="18"
                    HorizontalAlignment="Stretch"
                    Click="GoToSignIn_Click">

                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="1,0">
                        <GradientStop Color="#3B82F6"
                                      Offset="0"/>
                        <GradientStop Color="#2563EB"
                                      Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>

            <!-- Create Account Button -->
            <Button Content="Create Account"
                    Height="64"
                    FontSize="21"
                    FontWeight="SemiBold"
                    CornerRadius="18"
                    HorizontalAlignment="Stretch"
                    Click="GoToSignUp_Click">

                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="1,0">
                        <GradientStop Color="#4F46E5"
                                      Offset="0"/>
                        <GradientStop Color="#4338CA"
                                      Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>

        </StackPanel>

    </Grid>
</Page>