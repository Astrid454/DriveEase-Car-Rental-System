<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Project.Views.Dashboard.Admin.AdminGaragesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Project.Views.Dashboard.Admin"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid Padding="40">

            <StackPanel Spacing="28">

                <StackPanel Spacing="6">
                    <TextBlock Text="Garages"
                               FontSize="32"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Manage garage inventory, maintenance and vehicle activity."
                               FontSize="16"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Padding="24"
                            CornerRadius="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Garages" FontSize="16"/>
                            <TextBlock x:Name="GaragesCountText"
                                       Text="0"
                                       FontSize="32"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="DriveEase garage locations"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Padding="24"
                            CornerRadius="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Cars in maintenance" FontSize="16"/>
                            <TextBlock x:Name="MaintenanceCarsText"
                                       Text="0"
                                       FontSize="32"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Vehicles currently unavailable"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Padding="24"
                            CornerRadius="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Open support tickets" FontSize="16"/>
                            <TextBlock x:Name="SupportTicketsText"
                                       Text="0"
                                       FontSize="32"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Tickets related to vehicles"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Padding="24"
                        CornerRadius="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                    <StackPanel Spacing="18">

                        <ComboBox x:Name="GarageComboBox"
                                  Header="Select garage"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="GarageComboBox_SelectionChanged"/>

                        <TextBlock x:Name="SelectedGarageTextBlock"
                                   Text="Cars in selected garage"
                                   FontSize="22"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="GarageCapacityText"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <ListView x:Name="CarsListView"
                                  IsItemClickEnabled="True"
                                  ItemClick="CarsListView_ItemClick"
                                  SelectionMode="None">

                            <ListView.ItemTemplate>
                                <DataTemplate>

                                    <Border Padding="18"
                                            Margin="0,0,0,12"
                                            CornerRadius="12"
                                            BorderThickness="1"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">

                                        <Grid ColumnSpacing="16">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0"
                                                        Spacing="4">

                                                <TextBlock Text="{Binding Brand}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"/>

                                                <TextBlock Text="{Binding Model}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                                <TextBlock Text="{Binding PlateNumber}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                         Spacing="6">

                                                <TextBlock Text="Status"
                                                               FontSize="13"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                                <Border Padding="10,4"
                                                        CornerRadius="12"
                                                        Background="{Binding StatusColor}">



                                                    <TextBlock Text="{Binding MaintenanceStatus}"
                                                               FontWeight="SemiBold"
                                                               Foreground="White"/>

                                                </Border>

                                            </StackPanel>

                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="Owner ID"
                                                           FontSize="13"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                                <TextBlock Text="{Binding UserId}"
                                                           FontWeight="SemiBold"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="3"
                                                        Orientation="Horizontal"
                                                        Spacing="10"
                                                        VerticalAlignment="Center">

                                                <Button Content="Maintenance"
                                                        Click="MoveToMaintenance_Click"/>

                                                <Button Content="Available"
                                                        Click="MarkAvailable_Click"/>
                                                
                                            </StackPanel>

                                        </Grid>
                                    </Border>

                                </DataTemplate>
                            </ListView.ItemTemplate>

                        </ListView>

                    </StackPanel>

                </Border>

            </StackPanel>

        </Grid>
    </ScrollViewer>
</Page>