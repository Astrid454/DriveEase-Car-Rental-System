<Page
    x:Class="Project.Views.Dashboard.Admin.AdminVehicleDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <Grid Padding="40">
            <StackPanel Spacing="22">

                <Button Content="← Back"
                        Width="100"
                        Click="Back_Click"/>

                <TextBlock Text="Vehicle Details"
                           FontSize="32"
                           FontWeight="SemiBold"/>

                <Border Padding="24"
                        CornerRadius="18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="CarTitleText" FontSize="28" FontWeight="SemiBold"/>
                        <TextBlock x:Name="PlateText"/>
                        <TextBlock x:Name="YearText"/>
                        <TextBlock x:Name="GarageText"/>
                        <TextBlock x:Name="OwnerText"/>
                        <TextBlock x:Name="CarStatusText"/>
                    </StackPanel>
                </Border>

                <Border Padding="24"
                        CornerRadius="18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Active reservation"
                                   FontSize="22"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="ReservationStatusText"/>
                        <TextBlock x:Name="CustomerText"/>
                        <TextBlock x:Name="PickupText"/>
                        <TextBlock x:Name="ReturnText"/>
                        <TextBlock x:Name="PickedUpText"/>
                        <TextBlock x:Name="ReturnedText"/>
                    </StackPanel>
                </Border>

                <Border Padding="24"
                        CornerRadius="18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Maintenance availability"
                                   FontSize="22"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="MaintenanceAllowedText"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>